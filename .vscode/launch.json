{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (CMake)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "Build",
      "windows": { "miDebuggerPath": "gdb.exe" },
      "linux": { "miDebuggerPath": "/usr/bin/gdb" },
      "osx": { "miDebuggerPath": "/usr/bin/lldb", "MIMode": "lldb" }
    }
  ]
}
