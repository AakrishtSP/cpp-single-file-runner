{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "./run.sh -B",
      "windows": { "command": "python run.py -B" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "CMake configure + build of src/main.cpp"
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "./run.sh",
      "windows": { "command": "python run.py" },
      "group": "test",
      "problemMatcher": ["$gcc"],
      "detail": "Build and run src/main.cpp"
    },
    {
      "label": "Build current file",
      "type": "shell",
      "command": "./run.sh -B -f \"${relativeFile}\"",
      "windows": { "command": "python run.py -B -f \"${relativeFile}\"" },
      "problemMatcher": ["$gcc"],
      "detail": "Compile the file open in the editor"
    },
    {
      "label": "Run current file",
      "type": "shell",
      "command": "./run.sh -f \"${relativeFile}\"",
      "windows": { "command": "python run.py -f \"${relativeFile}\"" },
      "problemMatcher": ["$gcc"],
      "detail": "Compile and run the file open in the editor"
    },
    {
      "label": "Run current file with import std",
      "type": "shell",
      "command": "./run.sh -i -f \"${relativeFile}\"",
      "windows": { "command": "python run.py -i -f \"${relativeFile}\"" },
      "problemMatcher": ["$gcc"],
      "detail": "C++23 std module build of the open file"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build build-import-std",
      "windows": { "command": "cmd /c rmdir /s /q build 2>nul & rmdir /s /q build-import-std 2>nul" },
      "detail": "Delete the build directories"
    }
  ]
}
