{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "./run.sh -B",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1 -BuildOnly" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "CMake configure + build of src/main.cpp"
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "./run.sh",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1" },
      "group": "test",
      "problemMatcher": ["$gcc"],
      "detail": "Build and run src/main.cpp"
    },
    {
      "label": "Build current file",
      "type": "shell",
      "command": "./run.sh -B -f \"${relativeFile}\"",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1 -BuildOnly -File \"${relativeFile}\"" },
      "problemMatcher": ["$gcc"],
      "detail": "Compile the file open in the editor"
    },
    {
      "label": "Run current file",
      "type": "shell",
      "command": "./run.sh -f \"${relativeFile}\"",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1 -File \"${relativeFile}\"" },
      "problemMatcher": ["$gcc"],
      "detail": "Compile and run the file open in the editor"
    },
    {
      "label": "Run current file with import std",
      "type": "shell",
      "command": "./run.sh -i -f \"${relativeFile}\"",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1 -ImportStd -File \"${relativeFile}\"" },
      "problemMatcher": ["$gcc"],
      "detail": "C++23 std module build of the open file"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build",
      "windows": { "command": "powershell -NoProfile -Command \"if (Test-Path build) { Remove-Item -Recurse -Force build }\"" },
      "detail": "Delete the build directory"
    }
  ]
}
